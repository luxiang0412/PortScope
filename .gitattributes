# Normalise line endings to LF in the repository and in every checkout.
#
# This machine (and any Windows contributor with core.autocrlf=true) otherwise
# converts files to CRLF on checkout, which is not merely cosmetic:
# `desktop-file-validate` rejects a .desktop file with carriage returns, and
# shell scripts break. Found by validating a fresh clone.
* text=auto eol=lf

# Never convert binaries.
*.png binary
*.mo binary

# These must always be LF regardless of any user configuration.
*.sh            text eol=lf
*.desktop       text eol=lf
*.xml           text eol=lf
*.po            text eol=lf
*.rs            text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
