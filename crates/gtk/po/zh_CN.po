# Application name. Kept identical in both languages: it is a product name.
msgid "PortScope"
msgstr "PortScope"
# TRANSLATORS: navigation entry for network endpoints.
msgid "Ports"
msgstr "端口"
# TRANSLATORS: navigation entry for local processes.
msgid "Processes"
msgstr "进程"
# TRANSLATORS: navigation entry for systemd units.
msgid "Services"
msgstr "服务"
# ---------------------------------------------------------------------------
# Search and filtering
# ---------------------------------------------------------------------------
msgid "Search ports, processes, services…"
msgstr "搜索端口、进程、服务…"
msgid "Search ports…"
msgstr "搜索端口…"
msgid "Search processes…"
msgstr "搜索进程…"
msgid "Search services…"
msgstr "搜索服务…"
msgid "Refresh"
msgstr "刷新"
msgid "Menu"
msgstr "菜单"
# TRANSLATORS: filter meaning "all protocols".
msgid "All protocols"
msgstr "全部协议"
msgid "TCP only"
msgstr "仅 TCP"
msgid "UDP only"
msgstr "仅 UDP"
# TRANSLATORS: filter meaning "all address families".
msgid "All addresses"
msgstr "全部地址"
msgid "IPv4 only"
msgstr "仅 IPv4"
msgid "IPv6 only"
msgstr "仅 IPv6"
# TRANSLATORS: filter for endpoints whose owning process could not be read.
msgid "Unknown owner only"
msgstr "仅所有者未知"
# ---------------------------------------------------------------------------
# Table column headers
# ---------------------------------------------------------------------------
msgid "Protocol"
msgstr "协议"
msgid "Local address"
msgstr "本地地址"
msgid "Port"
msgstr "端口"
# TRANSLATORS: socket state column (LISTEN, UNCONN…). Not the unit state.
msgid "State"
msgstr "状态"
msgid "Process"
msgstr "进程"
msgid "PID"
msgstr "PID"
msgid "User"
msgstr "用户"
msgid "Systemd unit"
msgstr "systemd 单元"
msgid "Name"
msgstr "名称"
msgid "Endpoints"
msgstr "端点"
msgid "Command line"
msgstr "命令行"
msgid "Unit"
msgstr "单元"
msgid "Scope"
msgstr "作用范围"
# TRANSLATORS: systemd ActiveState column.
msgid "Sub state"
msgstr "子状态"
msgid "Main PID"
msgstr "主进程 PID"
msgid "Associated ports"
msgstr "关联端口"
# ---------------------------------------------------------------------------
# Detail pane
# ---------------------------------------------------------------------------
msgid "Details"
msgstr "详情"
msgid "Evidence"
msgstr "证据"
msgid "No selection"
msgstr "未选择"
msgid "Select a row to see details."
msgstr "选择一行以查看详情。"
msgid "Inode"
msgstr "inode"
msgid "cgroup"
msgstr "cgroup"
msgid "PPID"
msgstr "PPID"
msgid "UID"
msgstr "UID"
msgid "Start time"
msgstr "启动时间"
msgid "Command"
msgstr "命令"
msgid "Raw values are shown exactly as reported by the system and are not translated."
msgstr "原始值按系统报告原样显示，未经翻译。"
# ---------------------------------------------------------------------------
# Status bar
# ---------------------------------------------------------------------------
msgid "Data collected"
msgstr "数据已采集"
msgid "degraded"
msgstr "降级"
msgid "Loaded"
msgstr "已加载"
# TRANSLATORS: shown when a refresh failed and the data on screen is old.
msgid "Data may be stale"
msgstr "数据可能已过期"
msgid "Refreshing…"
msgstr "正在刷新…"
msgid "Refresh cancelled"
msgstr "刷新已取消"
msgid "Search returned no results."
msgstr "搜索无结果。"
msgid "Try a different search or clear the filters."
msgstr "请尝试其他搜索词或清除筛选条件。"
msgid "Nothing to show"
msgstr "没有可显示的内容"
msgid "No endpoints were reported by the system."
msgstr "系统未报告任何端点。"
# ---------------------------------------------------------------------------
# Errors and permission states
# ---------------------------------------------------------------------------
msgid "Some information is unavailable"
msgstr "部分信息无法获取"
msgid "Permission denied"
msgstr "权限不足"
# TRANSLATORS: explains that some endpoints' owning processes are hidden.
msgid "Ports owned by other users are not visible without additional privileges. PortScope does not request them."
msgstr "属于其他用户的端口在无额外权限时不可见。PortScope 不会主动申请这些权限。"
msgid "The system journal is not readable by this user, so logs are unavailable. Other diagnostics still work."
msgstr "当前用户无法读取系统日志，因此日志不可用。其他诊断功能仍可使用。"
msgid "Retry"
msgstr "重试"
msgid "Collection failed"
msgstr "采集失败"
# TRANSLATORS: a tool (ss, systemctl, journalctl) did not answer in time.
msgid "A required system tool did not respond in time."
msgstr "所需的系统工具未及时响应。"
msgid "A required system tool is missing."
msgstr "缺少所需的系统工具。"
msgid "Unknown"
msgstr "未知"
msgid "Unavailable"
msgstr "无法获取"
msgid "Not queried"
msgstr "未查询"
msgid "No longer running"
msgstr "已不再运行"
msgid "No confirmable association"
msgstr "未发现可确认的关联"
# ---------------------------------------------------------------------------
# Service / unit states (values stay English; these are the UI explanations)
# ---------------------------------------------------------------------------
msgid "active"
msgstr "运行中"
# TRANSLATORS: an inactive unit is NOT a fault.
msgid "inactive"
msgstr "未运行"
msgid "failed"
msgstr "失败"
msgid "activating"
msgstr "正在启动"
msgid "deactivating"
msgstr "正在停止"
msgid "reloading"
msgstr "正在重新加载"
msgid "not-found"
msgstr "不存在"
msgid "system"
msgstr "系统"
msgid "user"
msgstr "用户"
# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
msgid "Recent logs"
msgstr "近期日志"
msgid "Last 15 minutes"
msgstr "最近 15 分钟"
msgid "No log entries in this window."
msgstr "此时间范围内没有日志条目。"
msgid "Log entries"
msgstr "日志条目"
msgid "Copy entry"
msgstr "复制条目"
msgid "Log text is shown verbatim and is never translated."
msgstr "日志原文按原样显示，不做翻译。"
# ---------------------------------------------------------------------------
# Menu, settings, about
# ---------------------------------------------------------------------------
msgid "Language"
msgstr "语言"
msgid "System default"
msgstr "跟随系统"
msgid "Appearance"
msgstr "外观"
msgid "Light"
msgstr "浅色"
msgid "Dark"
msgstr "深色"
msgid "Follow system"
msgstr "跟随系统"
msgid "Auto-refresh"
msgstr "自动刷新"
msgid "Off"
msgstr "关闭"
msgid "5 seconds"
msgstr "5 秒"
msgid "10 seconds"
msgstr "10 秒"
msgid "30 seconds"
msgstr "30 秒"
msgid "Settings"
msgstr "设置"
msgid "About PortScope"
msgstr "关于 PortScope"
msgid "Copy diagnostic summary"
msgstr "复制诊断摘要"
msgid "Diagnostic summary copied to the clipboard."
msgstr "诊断摘要已复制到剪贴板。"
msgid "Copy"
msgstr "复制"
msgid "Close"
msgstr "关闭"
msgid "Cancel"
msgstr "取消"
msgid "Keyboard shortcuts"
msgstr "键盘快捷键"
msgid "Focus search"
msgstr "聚焦搜索框"
msgid "Open details"
msgstr "打开详情"
msgid "Back"
msgstr "返回"
# TRANSLATORS: body of the about dialog. {} is the version number.
msgid "A local port, process and service inspector."
msgstr "本机端口、进程与服务诊断工具。"
msgid "Version {}"
msgstr "版本 {}"
msgid "Diagnostic summary contents"
msgstr "诊断摘要包含的内容"
msgid "The summary includes ports, processes, services, evidence and collection time. It does not include full command lines."
msgstr "摘要包含端口、进程、服务、证据与采集时间。不包含完整命令行。"
# --- Settings window (taskbook §5.7) ---
msgid "The manual choice overrides the system language and is kept after restart."
msgstr "手动选择会覆盖系统语言，并在重启后保留。"
msgid "A refresh keeps your selection and filters, and marks data stale if it fails."
msgstr "刷新会保留当前选择与筛选条件；若刷新失败，数据会被标记为可能已过期。"
msgid "Collect the current state immediately."
msgstr "立即采集当前状态。"
msgid "Sort"
msgstr "排序"

# TRANSLATORS: short label for "follow the system language" in a dropdown.
msgid "System"
msgstr "跟随系统"
